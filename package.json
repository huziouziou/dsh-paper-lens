{
  "name": "dsh-paper-lens",
  "version": "0.5.4",
  "description": "Paper Lens: read PDFs in the DSH right sidebar, select text to translate (streaming, 10 languages), quote it into the chat, and annotate. Runs on the session model, a pinned model, or a local llama.cpp translation server. 论文阅读：侧边栏 PDF、划词翻译、划词引用、批注。",
  "publishConfig": {
    "access": "public"
  },
  "icon": "assets/icon.png",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/*.js",
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "LICENSE",
    "dsh.plugin.json",
    "screenshots.json",
    "screenshots",
    "assets/icon.png",
    "detail",
    "locale"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "external": []
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "pdf",
    "pdf-reader",
    "translation",
    "annotations",
    "local-llm",
    "citations",
    "papers"
  ],
  "author": "Paper Lens contributors (fork of dsh-cite-lens 0.3.1 by Adithya N Raj)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huziouziou/dsh-paper-lens.git"
  },
  "homepage": "https://github.com/huziouziou/dsh-paper-lens#readme",
  "bugs": {
    "url": "https://github.com/huziouziou/dsh-paper-lens/issues"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pdfjs-dist": "^6.4.299"
  }
}
